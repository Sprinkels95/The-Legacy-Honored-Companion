# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Kept strictly server-side (NO VITE_ prefix).
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=""

# DISCORD_WEBHOOK_URL: Discord channel webhook URL for real-time caregiver alerts & phone notifications.
# Paste your Discord Channel Webhook URL (e.g., https://discord.com/api/webhooks/...)
DISCORD_WEBHOOK_URL=""

# CAREGIVER_PHONE_NUMBER: Phone number for emergency caregiver calls (e.g. +15551234567)
CAREGIVER_PHONE_NUMBER="+15551234567"

# TWILIO_ACCOUNT_SID: Twilio Account SID from twilio.com/console
TWILIO_ACCOUNT_SID=""

# TWILIO_AUTH_TOKEN: Twilio Auth Token from twilio.com/console (kept strictly server-side)
TWILIO_AUTH_TOKEN=""

# TWILIO_PHONE_NUMBER: Your purchased Twilio phone number (e.g. +15559876543)
TWILIO_PHONE_NUMBER="+15559876543"

# UBER_CLIENT_ID: Uber Developer App Client ID for ride dispatching and deep linking
UBER_CLIENT_ID="your_uber_client_id_here"

# UBER_CLIENT_SECRET: Uber Developer App Client Secret (kept strictly server-side)
UBER_CLIENT_SECRET=""

# UBER_SERVER_TOKEN: Uber Developer Server Token (optional for direct Sandbox API calls)
UBER_SERVER_TOKEN=""
